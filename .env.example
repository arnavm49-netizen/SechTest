# ── Database ──
# Local: use docker-compose.yml to start Postgres
# Production: set in Render dashboard
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/psychometrics?schema=public"

# ── Authentication ──
# Must be at least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-random-secret-at-least-32-characters"

# ── App URL ──
# Local development
APP_URL="http://localhost:3000"

# ── Token TTL ──
ACCESS_TOKEN_TTL_MINUTES="15"
REFRESH_TOKEN_TTL_DAYS="30"
